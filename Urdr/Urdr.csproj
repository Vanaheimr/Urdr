<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>org.GraphDefined.Vanaheimr.Urdr</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>
  <ItemGroup>
    <!-- Hermod's HTTP client, which resolves the TSA's host name with the DNS client it is given:
         the runtime's HttpClient would ask the resolver of the operating system. -->
    <ProjectReference Include="..\..\Hermod\Hermod\Hermod.csproj" />
  </ItemGroup>
</Project>
